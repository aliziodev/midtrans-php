# Sandbox credentials for the integration suite.
#
# Copy to .env and fill in. .env is gitignored — never commit real keys, and
# never put a production key here: the suite always points at the sandbox host
# and refuses to run against anything else.
#
#   cp .env.example .env
#   composer test:integration

# Dashboard > Settings > Access Keys, with Environment set to Sandbox.
#
# Older sandbox accounts issue keys prefixed SB-Mid-server-; newer ones issue
# Mid-server-, which is what production keys have always looked like. The prefix
# therefore proves nothing about which environment a key belongs to. The suite
# decides that from the host it is pointed at instead, and always points at
# sandbox.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Snap-BI, optional. See the README for how to register your public key.
MIDTRANS_SNAP_BI_CLIENT_ID=
MIDTRANS_SNAP_BI_CLIENT_SECRET=
MIDTRANS_SNAP_BI_PARTNER_ID=
MIDTRANS_SNAP_BI_PRIVATE_KEY_PATH=
